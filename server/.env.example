# ========================================
# 伺服器設定
# ========================================
PORT=3000
NODE_ENV=development

# ========================================
# Azure Speech Services (STT + TTS)
# ========================================
# 取得方式: https://portal.azure.com -> Azure AI services -> Speech
# 同一組金鑰同時用於：
#   - STT（語音辨識，/stt WebSocket）
#   - TTS（LiveAvatar Lite Mode 合成，/liveavatar-speak WebSocket）
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=japaneast

# Azure TTS 預設聲音與語系（呼叫端可在 speak event 動態覆寫）
# Voice 清單: https://learn.microsoft.com/azure/ai-services/speech-service/language-support?tabs=tts
# 預設使用台灣中文女聲 HsiaoChen
AZURE_TTS_VOICE_NAME=zh-TW-HsiaoChenNeural
AZURE_TTS_LANGUAGE=zh-TW

# ========================================
# LiveAvatar API 設定
# ========================================
# LiveAvatar API Key
# 取得方式: https://app.heygen.com/settings?nav=API
LIVEAVATAR_API_KEY=your-liveavatar-api-key
LIVEAVATAR_API_URL=https://api.liveavatar.com

# LiveAvatar 預設 Avatar 和 Voice
# Avatar ID: https://app.heygen.com/avatars (點擊 avatar 查看 ID)
# Voice ID: https://app.heygen.com/voices
# Sandbox 測試用 Avatar ID: dd73ea75-1218-4ef3-92ce-606d5f7fbc0a (Wayne)
AVATAR_ID=your-avatar-id
VOICE_ID=your-voice-id

# ========================================
# 安全性設定
# ========================================
# CORS 允許的來源 (逗號分隔)
CORS_ORIGIN=http://localhost:3000,http://localhost:8000,http://localhost:8080

# API 認證金鑰 (前端透過 x-api-key header 驗證)
API_KEY=your-api-key

# ========================================
# ElevenLabs TTS (DEPRECATED, 已改用 Azure TTS)
# ========================================
# 2026-05-25 起 LiveAvatar Lite Mode 改由 Azure TTS 合成。
# 以下變數保留僅供回滾參考，新部署無需設定。
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
